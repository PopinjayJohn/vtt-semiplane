package web

import "github.com/PopinjayJohn/vtt-semiplane/internal/httpapi"

// The reveal and revoke controls, and the audit view at /admin/secrets.
//
// Both are in one file because both are the surface §8.3 puts on a page the DM
// reads: one decides a fence, and one says what has been decided.

// SecretControls is what a DM is offered on one fence.
//
// **The absence is the design.** Both action fields are empty for a principal the
// route's gate refuses, and this renders nothing at all in that case — not a
// disabled button, not a greyed-out row, nothing. A control whose activation
// answers 403 is a broken control wearing a permission's clothes, and AGENTS.md §7
// calls the absence of a capability degrading to a broken control a bug. The
// handler fills those fields by asking authz.Policy the same question the route
// asks, so the button and the gate are one answer rather than two that can drift.
//
// Which of the two appears is decided by the fence's own state and not by the
// reader: a fence already shared with the table gets the revoke, and everything
// else gets the reveal. Offering both would put a no-op on the page — the service
// refuses to write a file that already says what it says — and a control that does
// nothing when pressed is the other half of the same fault.
//
// The forms are ordinary forms. There is no script on this page, the CSRF token
// comes from the one component every form in this codebase uses, and the answer to
// either is a 303 back to the page the reader is on.
templ SecretControls(secret httpapi.SecretView, csrf string) {
	if secret.RevealAction != "" || secret.RevokeAction != "" {
		<nav aria-label="This secret" class="mt-2 flex flex-wrap items-center gap-2">
			// Two ifs inside the section rather than one branch choosing a
			// component: templ v0.3.1020 compiles a `continue` whose loop body
			// contains markup into the literal word "continue", which AGENTS.md §11
			// records as having shipped. The shape here is the one context.templ
			// uses for the same reason.
			if secret.RevealAction != "" && !secret.Revealed {
				@secretAction(secret.RevealAction, csrf, "i-unlock", "Reveal to the table")
			}
			if secret.RevokeAction != "" && secret.Revealed {
				@secretAction(secret.RevokeAction, csrf, "i-lock", "Hide it again")
			}
		</nav>
	}
}

// secretAction is one of the two forms.
//
// The wording says what the button does and is not hedged: revealing publishes
// this fence to every account in the campaign, and a reader about to press that
// should not have to infer it from the word "reveal". The icon is beside the words
// rather than instead of them for the reason IconButton's comment gives.
templ secretAction(action, csrf, icon, label string) {
	<form method="post" action={ action } class="contents">
		@CSRFInput(csrf)
		<button type="submit" class="btn">
			@Icon(icon, "h-4 w-4")
			<span>{ label }</span>
		</button>
	</form>
}

// AdminSecrets is the secret audit trail, at /admin/secrets.
//
// It carries no body, no title, no author and no length, and the reason is not
// this template's restraint: httpapi.SecretEventRow is a projection of a store row
// that holds none of those fields, so there is nothing here to leak even by a
// mistake in a renderer. §8.8 is kept by not selecting the columns.
templ AdminSecrets(v httpapi.AdminSecretsView) {
	<section aria-labelledby="secret-audit-heading">
		<h1 id="secret-audit-heading" data-focus-target class="text-2xl font-semibold tracking-tight">Secret audit trail</h1>
		<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
			Every time a secret was created, shared or hidden again, and who did it. This page
			records that something happened to a secret — never what it said.
		</p>
		@secretAudit(v)
	</section>
}

// secretAudit is the table, or the sentence that replaces it.
//
// The scope is one account's trail, and the page says so rather than letting a
// reader infer a campaign-wide one: a reader told "who has touched the campaign's
// secrets" and handed their own history would draw the wrong conclusion from a
// page that is answering correctly.
templ secretAudit(v httpapi.AdminSecretsView) {
	<section aria-labelledby="secret-audit-table-heading" class="mt-4">
		<h2 id="secret-audit-table-heading" class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
			@Icon("i-list", "h-4 w-4")
			What has been revealed and hidden again
		</h2>
		if len(v.Events) == 0 {
			<div class="mt-2">
				@EmptyState("Nothing has been recorded yet", noAuditNote())
			</div>
		} else {
			// The wrapper scrolls rather than widening, for the reason the plugin
			// report's table has one: #content is a grid column with a minimum
			// inline size of zero, so a wide table without a scroll container of
			// its own pushes the whole shell sideways.
			<div class="mt-2 overflow-x-auto">
				<table class="table">
					<caption class="sr-only">
						Every recorded change to a secret, newest first: when it happened, what was
						done, which account did it, which secret it was about and the visibility
						before and after
					</caption>
					<thead>
						<tr>
							<th scope="col">When</th>
							<th scope="col">Action</th>
							<th scope="col">Account</th>
							<th scope="col">Secret</th>
							<th scope="col">Visibility</th>
						</tr>
					</thead>
					<tbody>
						for _, ev := range v.Events {
							@secretAuditRow(ev)
						}
					</tbody>
				</table>
			</div>
			<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
				Newest first, at most { itoa(v.ShownLimit) } { plural(v.ShownLimit, "entry", "entries") }
				from this account.
			</p>
		}
	</section>
}

// secretAuditRow is one event.
//
// The visibility cell says both ends of the change — "private → table" — rather
// than only where it landed, because the direction is the fact: a secret that
// became readable and one that stopped being readable are opposite events and a
// column showing only the destination cannot tell a reader which happened.
templ secretAuditRow(ev httpapi.SecretEventRow) {
	<tr data-audit-action={ ev.Action }>
		<td>
			<time datetime={ ev.At.UTC().Format("2006-01-02T15:04:05Z07:00") }>
				{ ev.At.UTC().Format("2006-01-02 15:04") }
			</time>
		</td>
		<td>
			@Badge(ev.Action, "bg-neutral-200 px-1.5 py-0.5 text-xs")
		</td>
		<td>{ ev.Actor }</td>
		<td>
			<code>{ ev.SecretID }</code>
		</td>
		<td>
			@auditVisibility(ev.FromVis, ev.ToVis)
		</td>
	</tr>
}

// auditVisibility is the from → to cell.
//
// An empty side is written as "—" rather than left blank, because a blank cell is
// a column that failed to render and a create or a delete genuinely has no
// visibility on one side of it. The dash is the sentence.
templ auditVisibility(from, to string) {
	<span class="whitespace-nowrap">{ orDash(from) } → { orDash(to) }</span>
}

func orDash(visibility string) string {
	if visibility == "" {
		return "—"
	}
	return visibility
}

// noAuditNote explains an empty trail.
templ noAuditNote() {
	<p>
		No secret has been created, revealed or hidden by this account. The trail is written
		by the app, so a change somebody made in a text editor is in the file and not here.
	</p>
}
