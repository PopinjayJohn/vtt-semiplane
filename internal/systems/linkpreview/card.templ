package linkpreview

// summaryCard is the body of a link preview: what a card says about a page.
//
// It is markup over a Go value and nothing else. There is no event handler, no
// behaviour-binding attribute, no stylesheet of its own, no class name the
// committed stylesheet has never heard of, and no id at all — which is not
// restraint, it is the only option the architecture offers. The Host interface
// has no method that could install one, a plugin table may not carry a
// JavaScript column, and app.js and the stylesheet are core-owned. That is the
// whole reason the preview interaction is written once in core rather than once
// per plugin: N implementations of focus management, an arbitrary-markup hole in
// the CSP, and N accessibility bugs.
//
// The classes are core's. card, card-heading and the neutral palette are tokens
// internal/web already uses, and reusing them is what "a plugin ships no CSS"
// looks like in practice.
//
// Three things are deliberately absent.
//
// There is no link. A card that contains a link is a second navigation target
// inside a transient tooltip, and the reader who follows the link they were
// already following has been sent somewhere the click did not obviously mean.
//
// There is no pin button, and no button of any kind. The pin is the one
// interactive element in a preview card and it belongs to core, because acting
// on it is behaviour and a plugin cannot ship behaviour. A button rendered here
// with nothing behind it is a control with nothing behind it.
//
// And there is no fallback, no "no summary available" state, and no empty card.
// A decline is ok=false, and core answers it with a 404 that is byte-identical
// to navigating to the page, because a card that says "you may not see this" is
// the existence leak the whole feature is built to avoid.
//
// Every value below is rendered through templ's escaping, so a title, an excerpt
// or a tag that contains markup is shown as the text it is. That is the reason
// this file cannot use templ.Raw, and the reason it must not: a preview is the
// one surface that shows a page's own words to somebody who has not opened it.
templ summaryCard(c Card) {
	<article class="card p-3 text-sm">
		<h3 class="card-heading font-semibold leading-snug">{ c.Title }</h3>
		// The excerpt and the tags are each conditional rather than rendered
		// empty. A card with an empty paragraph under the title is a card whose
		// author left the page blank, which is a different claim from a card
		// that declines.
		//
		// The skip is written as an if inside the for rather than as a continue:
		// templ v0.3.1020 compiles a continue in a loop whose body contains
		// markup into the literal word "continue", and renders the element in
		// every slot. There is no continue here to miscompile, and the
		// alternative shape — filtering into a second slice in Go — is a second
		// list that could disagree with the first.
		if c.Excerpt != "" {
			<p class="mt-1 text-neutral-700 dark:text-neutral-300">{ c.Excerpt }</p>
		}
		if len(c.Tags) > 0 {
			<ul class="mt-2 flex flex-wrap gap-1 text-xs">
				for _, tag := range c.Tags {
					<li class="rounded border border-neutral-300 px-1.5 py-0.5 dark:border-neutral-700">
						{ tag }
					</li>
				}
			</ul>
		}
		// The date is in UTC and in the same shape internal/web's page list uses,
		// so a preview and a dashboard cannot describe the same edit two ways.
		// A zero timestamp means the indexer has not stamped the page, and a
		// card claiming the year 1 was edited is worse than no date at all.
		if !c.UpdatedAt.IsZero() {
			<time
				class="mt-2 block text-xs text-neutral-500 dark:text-neutral-400"
				datetime={ c.UpdatedAt.UTC().Format(stampLayout) }
			>
				{ c.UpdatedAt.UTC().Format(dayLayout) }
			</time>
		}
	</article>
}

// The two date layouts, named because a template cannot hold a conversion
// expression and an inline format string in two places is a format string in two
// places.
//
// The machine-readable one is RFC 3339 and is what the element carries, so the
// card states an instant rather than a date: a reader in a campaign that runs
// past midnight has a card that says the 2nd and no way to tell which 2nd. The
// visible one is the day, because that is the granularity a preview has room
// for.
const (
	stampLayout = "2006-01-02T15:04:05Z07:00"
	dayLayout   = "2006-01-02"
)
