# Pinned tool versions. Bump a version here and in one PR, never ad hoc.
#
# templ is pinned in go.mod via the `tool` directive (Go 1.24+) and is NOT
# listed here; `go tool templ` is the only supported way to run it. The version
# below is what CI asserts go.mod resolves to.
TEMPL_VERSION=v0.3.1020

# DataStar 1.0 stable syntax: data-on:click, not the beta data-on-click form.
DATASTAR_VERSION=1.0.4

# Tailwind v4 standalone CLI. No Node anywhere in the toolchain: the generated
# CSS is committed, so `go build` never needs this binary.
# https://github.com/tailwindlabs/tailwindcss/releases
TAILWIND_VERSION=4.1.16

# golangci-lint, used by `make lint`.
GOLANGCI_LINT_VERSION=2.5.0

# Pa11y CI, for the accessibility gate. Runs against a booted server.
PA11Y_CI_VERSION=4.0.1
