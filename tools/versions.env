# Pinned tool versions. Bump a version here and in one PR, never ad hoc.
#
# templ is pinned in go.mod via the `tool` directive (Go 1.24+) and is NOT
# listed here; `go tool templ` is the only supported way to run it. The version
# below is what CI asserts go.mod resolves to.
TEMPL_VERSION=v0.3.1020

# DataStar 1.0 stable syntax: data-on:click, not the beta data-on-click form.
DATASTAR_VERSION=1.0.4

# Tailwind v4 standalone CLI. No Node anywhere in the toolchain: the generated
# CSS is committed, so `go build` never needs this binary.
# https://github.com/tailwindlabs/tailwindcss/releases
TAILWIND_VERSION=4.1.16

# golangci-lint, used by `make lint`.
GOLANGCI_LINT_VERSION=2.5.0

# Pa11y CI, for the accessibility gate. Runs against a booted server.
# Consumed by scripts/pa11y.sh and .github/workflows/quality.yml; pa11y-ci 4.x
# needs an even-numbered Node of 20 or above, which is what NODE_VERSION below
# pins. pa11y-ci bundles its own Chromium through puppeteer, so nothing else in
# this repository has to know what a browser is.
PA11Y_CI_VERSION=4.0.1

# Node, only for the accessibility job. The repository's own toolchain has no
# Node in it: the stylesheet is generated by a standalone Tailwind binary and
# `go build` needs nothing else. This pin exists because pa11y-ci is an npm
# package, and nothing else in the tree is.
NODE_VERSION=24.21.0

# hey, the load-test driver scripts/loadtest.sh uses. Installed with
# `go install …@v$HEY_VERSION` into a throwaway GOBIN, so it is a tool and never
# a dependency: it does not appear in go.mod, and the static-binary promise
# does not depend on it.
HEY_VERSION=0.1.5
