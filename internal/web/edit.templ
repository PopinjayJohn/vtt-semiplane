package web

import "github.com/PopinjayJohn/vtt-semiplane/internal/httpapi"

// Edit is the page editor: one page's buffer, the hash it was built from, and
// the four answers a writer needs before touching any of it.
//
// The mode is at the top of the page and not in a footnote, because the two
// modes are the same control with different contents and a writer who does not
// know which one they are in is a writer who pastes a marker over somebody's
// secret. A redacted buffer is not a redacted page: the file behind it still
// holds the body, and the save is a splice, not a replacement.
templ Edit(v httpapi.EditView) {
	<section aria-labelledby="edit-heading">
		<h1 id="edit-heading" data-focus-target class="text-2xl font-semibold tracking-tight">
			Editing { v.Card.Title }
		</h1>
		<p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
			<code>{ v.Card.Path }</code>
			<span aria-hidden="true">·</span>
			<span>{ v.Card.PageType }</span>
		</p>
		@editNav(v)
		if v.Saved {
			@editSaved()
		}
		@editMode(v)
		@editProblems(v.Problems)
		if v.MayWrite {
			@editForm(v)
		} else {
			@editNoWrite(v)
		}
	</section>
}

// editNav is where the other three views of this file are, and it is a list of
// links rather than buttons: every one of them is a GET, and a reader who
// arrived here by opening a page has the file itself in the browser's cache.
templ editNav(v httpapi.EditView) {
	<nav aria-label="This page" class="mt-3 flex flex-wrap items-center gap-2">
		<a href={ v.PageHref } class="btn">
			@Icon("i-book", "h-4 w-4")
			<span>Read the page</span>
		</a>
		<a href={ v.RawHref } class="btn">
			@Icon("i-list", "h-4 w-4")
			<span>Markdown source</span>
		</a>
		<a href={ v.HistoryHref } class="btn">
			@Icon("i-list", "h-4 w-4")
			<span>History</span>
		</a>
	</nav>
}

// editSaved is the answer to a save that landed.
//
// It is a live region rather than a heading because it is the one thing on this
// page that a reader who submitted the form is waiting for, and a status region
// is what a screen reader announces without the reader having to go looking.
templ editSaved() {
	<p role="status" data-saved class="mt-4 rounded-md border border-rule bg-passthrough-bg p-3 text-sm">
		Saved. The buffer below is the file as it is on disk now, and the hash in this
		form is the one the next save is checked against.
	</p>
}

// editMode says which of the two buffers this is, before the buffer is on the
// screen.
//
// The redacted branch is the one that matters, and it is a callout rather than
// a line of small print because a marker standing where a body should be looks
// exactly like text the writer typed. So it says three things: how many
// secrets are standing in, that the markers must survive the save untouched,
// and that a hidden secret is not editable here at all. It does not describe
// what is inside a marker, because a marker is a restore token and §8.8 is about
// not describing tokens.
templ editMode(v httpapi.EditView) {
	if v.Mode == httpapi.EditModeRedacted {
		@Callout("border-secret/40 bg-secret-soft text-secret", "This editor is redacted", editRedactedNote(v.HiddenCount))
	} else {
		@Callout("border-neutral-300 bg-neutral-100 text-neutral-800 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200", "This editor is the whole file", editFullNote())
	}
}

templ editRedactedNote(hidden int) {
	<p>
		{ itoa(hidden) } { plural(hidden, "secret on this page is", "secrets on this page are") }
		hidden from you. Each one appears in the buffer below as a single marker standing in for
		text you may not read. The rest of the file is exactly as it is on disk.
	</p>
	<p class="mt-2">
		Leave every marker exactly as it is. A save that arrives with one changed is refused
		outright, and a hidden secret cannot be edited here — the page's owner or a DM edits
		it in the file.
	</p>
}

templ editFullNote() {
	<p>
		You are editing the whole file, the secrets in it included. What you save is written
		back byte for byte, and the file is the campaign.
	</p>
}

// editProblems are the parser's codes for this file.
//
// A code and a short message, never a line of the file: md.Problem carries the
// author a message about their Markdown and nothing about the secrets in it,
// and saying so here is what stops a reader treating the list as a quotation.
templ editProblems(problems []string) {
	if len(problems) > 0 {
		@Callout("border-secret/40 bg-secret-soft text-secret", "The parser reported a problem", editProblemList(problems))
	}
}

templ editProblemList(problems []string) {
	<ul class="list-disc space-y-1 ps-5">
		for _, problem := range problems {
			<li>
				<code>{ problem }</code>
			</li>
		}
	</ul>
	<p class="mt-2">
		These are codes, not quotations: nothing on this list is a line of your file, and a
		save is not blocked by any of them.
	</p>
}

// editForm is the one writable shape of the editor.
//
// The base hash is a hidden field rather than something the client sends later,
// because the hash is the page's state at the moment the buffer was built and a
// form that computed it at submit time would be checking a write against itself.
// data-editor-form is the hook Ctrl+S binds to; app.js reads it, and there is
// nothing else about the editor in the client.
templ editForm(v httpapi.EditView) {
	<form method="post" action={ v.Action } data-editor-form class="mt-4">
		@CSRFInput(v.CSRF)
		<input type="hidden" name="base_hash" value={ v.BaseHash }/>
		<div>
			<label for="edit-content" class="mb-1 block text-sm font-semibold">Markdown source</label>
			@editBuffer("edit-content", v.Content, true)
		</div>
		<div class="mt-3 flex flex-wrap items-center gap-2">
			<button type="submit" class="btn">
				Save
			</button>
			<p class="text-xs text-neutral-500 dark:text-neutral-400">Ctrl+S saves from anywhere on this page.</p>
		</div>
	</form>
}

// editNoWrite is the read-only half.
//
// No form at all, and that is the whole point: the server would refuse the
// submission, and a form whose button cannot work is a control that lies about
// what this reader may do. The buffer is still shown, and it is the same
// component, because "the same text, and you cannot type in it" is a smaller
// difference than a reader having to compare two pages to find out.
templ editNoWrite(v httpapi.EditView) {
	<p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300">
		You may read this page and you may not write it, so there is nothing to save here.
		What follows is the same buffer a writer would be handed.
	</p>
	<div class="mt-3">
		<label for="edit-content" class="mb-1 block text-sm font-semibold">Markdown source</label>
		@editBuffer("edit-content", v.Content, false)
	</div>
}

// editBuffer is the textarea, in both modes.
//
// It is one component because the two are the same control and a read-only copy
// that rendered differently would be a second thing to keep in step. The
// read-only copy carries no name, so it cannot be submitted even by a form this
// page did not write.
templ editBuffer(id, content string, editable bool) {
	if editable {
		<textarea
			id={ id }
			name="content"
			rows="24"
			spellcheck="false"
			autocapitalize="off"
			autocorrect="off"
			class="editor"
		>
			{ content }
		</textarea>
	} else {
		<textarea
			id={ id }
			rows="24"
			readonly
			spellcheck="false"
			class="editor"
		>
			{ content }
		</textarea>
	}
}
