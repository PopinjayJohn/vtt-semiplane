package web

import "github.com/PopinjayJohn/vtt-semiplane/internal/httpapi"

// Home is the dashboard.
templ Home(v httpapi.HomeView) {
	<section aria-labelledby="home-heading">
		<h1 id="home-heading" class="text-2xl font-semibold tracking-tight">Campaign</h1>
		<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
			{ itoa(v.PageCount) } pages indexed. These are the ones that changed most recently.
		</p>
		<div class="mt-4">
			@PageList(v.Pages, "No pages have been indexed yet. Add a Markdown file to the vault and it will appear here.")
		</div>
		@TagCloud(v.Tags)
	</section>
}

// Page is one page: its title, its rendered body, and the secrets on it.
//
// The body is the one place in this file that receives pre-rendered HTML, and it
// receives it from PreRendered, which is the single funnel. Everything else here
// is an ordinary templ expression and is escaped by templ.
//
// The page's own panels — the table of contents, the backlinks, the related
// pages, the campaign status — are not here. They are the shell's right column
// and the layout renders them from the same view model, so a page rendered inside
// the three-column shell and a context region fetched on its own cannot disagree
// about what a page has around it. Rendering them here as well would put two
// asides named "Context" on one page, which is one landmark too many and one
// answer too many.
//
// There is deliberately an edit link and nothing else, and both halves of that
// are decisions. app.js implements the `e` key by looking for a data-edit-href
// attribute, so the link the server renders is the whole of the affordance the
// key has: with it absent the key does nothing, and that absence is the
// permission check rather than a shortcut that answers 403. It is rendered from
// the view model's EditHref and never from a role comparison made here —
// httpapi.PageView says who may write this page, and a template that re-answered
// the question would be a second place in the codebase answering it.
templ Page(v httpapi.PageView) {
	<article class="prose-page">
		<header class="border-b border-neutral-200 pb-3 dark:border-neutral-800">
			<h1 data-focus-target class="text-2xl font-semibold tracking-tight">{ v.Card.Title }</h1>
			<p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
				<code>{ v.Card.Path }</code>
				<span aria-hidden="true">·</span>
				<span>{ v.Card.PageType }</span>
			</p>
		</header>
		if v.Truncated {
			@Callout("border-secret/40 bg-secret-soft text-secret", "This page is longer than one view", navp())
		}
		for _, problem := range v.Problems {
			@Callout("border-secret/40 bg-secret-soft text-secret", "The parser reported a problem", Text(problem))
		}
		<div class="prose-vtt mt-6 max-w-none">
			// A system plugin may have registered a viewer for this page's type.
			// When it did, that is the body; when it did not — which is the case
			// for every page of every campaign with no system plugin, and for
			// every page type that exists only as a frontmatter convention like
			// `type: houserule` — this is the core Markdown view. The default is
			// the core view and not a blank, because a page that renders as an
			// empty article when a plugin is absent is a broken page rather than
			// a degraded one.
			if v.Viewer != nil {
				@v.Viewer
			} else {
				@PreRendered(v.Body)
			}
		</div>
		if len(v.Secrets) > 0 {
			<section aria-labelledby="secrets-heading" class="mt-8 space-y-3">
				<h2 id="secrets-heading" class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
					Secrets on this page
				</h2>
				for _, secret := range v.Secrets {
					if secret.Hidden {
						@SecretLock(secret)
					} else {
						@SecretRevealed(secret)
					}
				}
			</section>
		}
		// Under the content and not in the header, and for the reason a long page
		// gives: this file can be four hundred kilobytes of Markdown, and the
		// reader who has just finished a page is at the end of it. It is also the
		// editor's own nav row reused, so the control a reader is asked to press
		// here is the one they will meet again on the other side of it.
		if v.EditHref != "" {
			<nav aria-label="This page" class="mt-3 flex flex-wrap items-center gap-2">
				@pageEditLink(v.EditHref)
			</nav>
		}
	</article>
}

// pageEditLink is the editor for the page being read.
//
// The href and the data attribute carry the same URL and both are there: the
// href is what makes this an ordinary link that works with this file blocked,
// and data-edit-href is what the `e` key looks for, because activating the
// anchor is a navigation the shell can swap in place. It takes the URL rather
// than the view model so that the one place that decides whether this link
// exists is the caller's guard on EditHref.
templ pageEditLink(href string) {
	<a href={ href } data-edit-href={ href } class="btn">
		@Icon("i-pencil", "h-4 w-4")
		<span>Edit this page</span>
	</a>
}

// navp is the truncation notice's body.
//
// It is a component rather than a string so that the wording lives in the
// template with everything else, and so that a caller changing the budget does
// not have to find the sentence that explains it.
templ navp() {
	<p>
		Only the first part of this file is shown, because goldmark's inline parser gets
		quadratic in the length of a single line and an unbounded render is a way to pin
		this server with one saved note. The file itself is untouched: it is the view
		that is clipped, and it will render in full once the page is split into shorter
		lines or moved to a page of its own.
	</p>
}
