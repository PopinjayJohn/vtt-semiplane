package web

import "github.com/PopinjayJohn/vtt-semiplane/internal/httpapi"

// Search is the search form and its results.
//
// The form is an ordinary GET form: with JavaScript blocked it submits, lands on
// the same URL, and produces the same results, because the results are rendered
// on the server either way. The fragment path is an enhancement over that and
// not a precondition for it.
//
// Typing is an enhancement over the form, and it is wired so that the response
// can replace the results and nothing else. Everything that must not be
// replaced while a reader is typing — the heading, the form, the input and its
// focus — is outside #search-results, and the request is expected to answer
// with datastar-selector: #search-results and datastar-mode: inner. Swapping
// the whole page region instead would put a second h1 in the document and take
// the caret out of the box the reader is typing into.
templ Search(v httpapi.SearchView) {
	<section aria-labelledby="search-heading">
		<h1 id="search-heading" data-focus-target class="text-2xl font-semibold tracking-tight">Search</h1>
		<form action="/search" method="get" role="search" data-search class="mt-4 flex items-center gap-2">
			<label for="q" class="sr-only">Search the campaign</label>
			<input
				id="q"
				name="q"
				type="search"
				value={ v.Query }
				autocomplete="off"
				placeholder="Search page text and the secrets shared with the table"
				class="w-full rounded border border-neutral-300 bg-white px-3 py-2 dark:border-neutral-700 dark:bg-neutral-900"
				{ typeaheadAttrs("/search?q=")... }
				data-indicator:search-fetching
			/>
			<button type="submit" class="rounded bg-accent-600 px-3 py-2 text-sm font-medium text-white">Search</button>
			<span data-show="$search-fetching" class="text-xs text-neutral-500 dark:text-neutral-400">Searching…</span>
		</form>
		if v.Failed {
			@Callout("border-secret/40 bg-secret-soft text-secret", "That search could not be run", searchUnusable())
		}
		// One region for the whole answer: the total, the rows and the reason
		// there are no rows all change together, and a swap that replaced the
		// total and left the rows would show a reader a count for results that
		// are not on the page.
		<div id="search-results">
			@searchResults(v)
		</div>
	</section>
}

// searchResults is what a search answered: a total, the rows, or the reason
// there are none.
//
// A failed query and an empty result set are different answers and are rendered
// differently. A server that could not run the query has not learned anything
// about the vault, and a page that says "nothing matched" in that case tells a
// reader that their term does not exist.
templ searchResults(v httpapi.SearchView) {
	if v.Failed {
		// The callout above has already said so. Repeating the sentence here is
		// what would make a failure and an empty result set look alike.
	} else if v.Query == "" {
		<p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
			Search covers page text and the secrets that have been revealed to the table.
			A secret still hidden to you is not searched, and its absence says nothing
			about whether it exists.
		</p>
	} else {
		<p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400" role="status">
			{ itoa(v.Total) } { plural(v.Total, "result", "results") } for
			<strong class="font-semibold">{ v.Query }</strong>
		</p>
		if len(v.Hits) == 0 {
			<p class="mt-3 rounded border border-dashed border-neutral-300 p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
				Nothing matched. Search covers page text and the secrets that have been revealed
				to the table; a secret still hidden to you is not searched, and its absence here
				says nothing about whether it exists.
			</p>
		} else {
			// Roving tabindex: one row in the tab order, the arrows move between
			// them, and Home and End jump. The rows are ordinary links, so Enter
			// following the link is the browser's own behaviour and the list is
			// usable with the script blocked.
			<ul data-roving class="mt-3 space-y-3">
				for _, hit := range v.Hits {
					<li class="rounded border border-neutral-200 p-3 dark:border-neutral-800">
						<a href={ hit.Card.Href() } { Wikilink(hit.Card.ID)... } data-roving-item class="font-medium hover:underline">{ hit.Card.Title }</a>
						if hit.Kind == "secret" {
							<span class="ml-2 rounded bg-revealed-soft px-1.5 py-0.5 text-xs text-revealed">
								from a shared secret
							</span>
						}
						<p class="mt-1 text-xs text-neutral-600 dark:text-neutral-400">
							<code>{ hit.Card.Path }</code>
						</p>
						if hit.Snippet != "" {
							<p class="mt-1 text-sm">
								@Escaped(hit.Snippet)
							</p>
						}
					</li>
				}
			</ul>
		}
	}
}

// searchUnusable is the notice for a query the server refused to run.
//
// It does not repeat the term, because the term is a thing the reader typed and
// this notice is the one place on the page that echoes input back in a context
// where a copy-paste could turn into a link.
templ searchUnusable() {
	<p>
		The search was too long or used a syntax this server will not pass to the index. A
		shorter phrase of ordinary words will work; the index is queried with terms, not with
		a query language.
	</p>
}
